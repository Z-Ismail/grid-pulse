# secrets — never commit
.env
settings.json

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# local data
data/

# Conductor workspaces and local Claude Code settings
.context/
.claude/settings.local.json

# The secrets rule above ignores every settings.json; shared Claude Code settings are safe to commit
!.claude/settings.json
